# WalimApp AI demo — environment template (copy to .env; never commit secrets)
# Meta Model API (https://api.meta.ai/v1) — server-side only.
# Without MODEL_API_KEY the app runs in clearly-labelled cached demo mode.
MODEL_API_KEY=
# Optional overrides (defaults verified against dev.meta.ai docs, 2026-11-03):
# META_API_BASE=https://api.meta.ai/v1
# META_SPARK_MODEL=muse-spark-1.3
# META_SAM_MODEL=sam-3.1
# META_IMAGE_MODEL=muse-image-1.0
PORT=3000
# Owner login (synced into storage at startup; required for /api/owner/*).
# OWNER_EMAIL=owner@example.dz
# OWNER_PASSWORD=change-me-123
# Super admin login (Task 08; provisioned at startup, no public registration).
# ADMIN_EMAIL=admin@example.dz
# ADMIN_PASSWORD=change-me-456
# MariaDB (optional; without these the server uses atomic JSON files in data/).
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=walimapp
# DB_PASSWORD=
# DB_NAME=walimapp

# Uncomment and set these to enable the seed owner demo:
# OWNER_EMAIL=owner@walimapp.dz
# OWNER_PASSWORD=ChooseAStrongPassword123!
